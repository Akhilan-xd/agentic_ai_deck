{
  // Per-paper pipeline. The PDF Feeder loads this once for each filename.
  "name": "paper_crew",

  "agents": ["paper_extractor", "librarian", "obsidian_publisher"],

  "tasks": [
    {
      "name": "extract_paper_fields",
      "description": "Use the Read PDF tool on {pdf_filename} and extract only from that tool result. Read the research paper {pdf_filename}. Extract these fields: title, abstract, problem formulation, proposed solution, method, dataset, performance metrics, related studies, state of the art, conclusion, future scope. Under Method, name each component separately (if the paper says the method has three components, list all three by name with one sentence each). Under Dataset, name the dataset and then list each named item inside it (benchmark, domain, task, or split) with one sentence each. Under Performance metrics, list each reported metric separately. Under Related studies, list each theme by a short reusable name, never by a section number. Quote or closely paraphrase the paper. If a field is absent, write NOT STATED.",
      "expected_output": "A labeled list with exactly these headings: Title, Abstract, Problem formulation, Proposed solution, Method, Dataset, Performance metrics, Related studies, State of the art, Conclusion, Future scope. Method lists each named component. Dataset lists each named item inside the dataset. Performance metrics lists each metric. Related studies lists each theme. Absent fields say NOT STATED.",
      "agent": "paper_extractor"
    },

    {
      "name": "write_library_notes",
      "description": "Call List Vault Notes before writing. Using the extracted fields, write Obsidian markdown with this structure. One paper note. One method note, plus one note for each named component of that method, and the method note links each component with [[Component Name]]. One dataset note, plus one note for each named item inside that dataset, and the dataset note links each item. One note for each performance metric, linked from a parent metrics note. One note for each related-study theme. Never title a note with a section number. Every note starts with YAML frontmatter: type (paper, method, dataset, metric, or study), topics as a list of short shared subject names, and source: \"[[Paper Title]]\". Reuse an existing note title from List Vault Notes whenever the subject is the same. The same subject must always use the same [[wikilink]], because that is what connects a new paper to notes already in the graph.",
      "expected_output": "A set of markdown notes. Each note has YAML frontmatter with type, topics, and source. The method note links each component. The dataset note links each item inside the dataset. Shared subjects reuse existing titles.",
      "agent": "librarian",
      "context": ["extract_paper_fields"]
    },

    {
      "name": "publish_notes",
      "description": "Read the librarian notes. For each note, call Save Obsidian Note once, including every method component and every dataset item. Put the paper note in papers, methods and method components in methods, datasets and dataset items in datasets, metrics in metrics, and related studies in studies. Pass the note title as title and the full markdown, including frontmatter, as body. Reuse a title that already exists when it is the same subject. Do not write topic notes yourself; shared topics are linked from the topics field.",
      "expected_output": "A short list of the files that were written or linked, one path per line.",
      "agent": "obsidian_publisher",
      "context": ["write_library_notes"]
    }
  ],

  "process": "sequential",
  "verbose": true,
  "memory": false,

  "inputs": {
    "pdf_filename": "2505.00527v2.pdf"
  }
}

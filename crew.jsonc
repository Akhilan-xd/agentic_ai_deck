{
  "name": "qa_crew",

  // The feeder is the only agent started by `crewai run`.
  // It calls Feed PDFs, which runs paper_crew.jsonc once per filename.
  "agents": ["pdf_feeder"],

  "tasks": [
    {
      "name": "feed_papers",
      "description": "The PDF list is {pdf_filenames}. Call the Feed PDFs tool once and pass that full list. The tool runs extraction, library notes, and publishing for every file. Do not skip a file and do not read the PDFs yourself. When the tool returns, report its status for each file.",
      "expected_output": "One status line per PDF, saying whether that paper was extracted and published.",
      "agent": "pdf_feeder"
    }
  ],

  "process": "sequential",
  "verbose": true,
  "memory": false,

  "inputs": {
    "pdf_filenames": ["2505.00527v2.pdf", "2406.09767v3.pdf"]
  }
}
